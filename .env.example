# Required for the default Anthropic model.
# Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Request Spectron access at https://surrealdb.com/agent-memory
# Required: API endpoint origin supplied by Spectron.
SPECTRON_ENDPOINT=
# Required: memory context shared by every teammate's conversations.
SPECTRON_CONTEXT=
# Required: bearer token for the Spectron API.
SPECTRON_API_KEY=
